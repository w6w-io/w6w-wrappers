{
  "name": "@w6w/cli",
  "version": "0.4.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "imports": {
    "@w6w/sdk": "../node/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "test": "deno test -A",
    "check": "deno check mod.ts bin/ scripts/ src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "cov": "deno test -A --coverage=.coverage && deno coverage .coverage",
    "gen:help": "deno run -A scripts/gen-help.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": ["dist", ".coverage", "node_modules", "tsconfig.build.json"]
}
