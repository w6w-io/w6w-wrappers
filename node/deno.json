{
  "name": "@w6w/sdk",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./console": "./src/console/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "test": "deno test -A",
    "check": "deno check mod.ts src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "cov": "deno test -A --coverage=.coverage && deno coverage .coverage"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": ["dist", ".coverage", "node_modules", "tsconfig.build.json"]
}
