{
  // npm build only, mirroring `../node/tsconfig.build.json` (D7's single-source
  // pattern does not apply here — this lane has no `deno.json` / JSR twin at
  // all, so there is only ever the one config).
  //
  // `rewriteRelativeImportExtensions` is what lets `src/`'s Deno-style `./x.ts`
  // (and `./x.tsx`) specifiers emit as `./x.js`, so the compiled ESM resolves
  // under plain Node. It needs `allowImportingTsExtensions`, and TypeScript 5.7
  // is the first release where that pair emits rather than erroring out — hence
  // the `>= 5.7` devDependency in package.json.
  //
  // Tests are excluded: `src/__tests__/*.test.ts` is run directly by
  // `node --test` (transpiled per-file by `src/test-jsx-loader.mjs`), never by
  // this build, and is not part of the published `dist/`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["mod.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/__tests__", "dist"]
}
